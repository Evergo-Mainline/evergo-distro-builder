root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 4
switch_case_indent = true

[Makefile]
indent_style = tab

[*.{bin,img,gz,tar.gz,simg}]
insert_final_newline = false
